source "https://rubygems.org"

# Local-preview stack: Jekyll + just-the-docs. The deployed site uses the
# GitHub Pages pipeline (configured via remote_theme in _config.yml).
gem "jekyll", "~> 4.3"
gem "just-the-docs"
gem "jekyll-remote-theme"
gem "webrick"
# Used by `jekyll serve --livereload` to push regeneration events to the browser.
gem "em-websocket"
